<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{32D69366-B27E-4524-8CD1-2F86108DF35E}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Samples\FMX\PDFLib-Simple\PDFLibSimple.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Samples\VCL\PDFLib-Basic\PDFLibBasic.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Samples\VCL\PDFLib-FormFields\PDFLibFormFields.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="PDFLibSimple">
        <MSBuild Projects="Samples\FMX\PDFLib-Simple\PDFLibSimple.dproj"/>
    </Target>
    <Target Name="PDFLibSimple:Clean">
        <MSBuild Projects="Samples\FMX\PDFLib-Simple\PDFLibSimple.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PDFLibSimple:Make">
        <MSBuild Projects="Samples\FMX\PDFLib-Simple\PDFLibSimple.dproj" Targets="Make"/>
    </Target>
    <Target Name="PDFLibBasic">
        <MSBuild Projects="Samples\VCL\PDFLib-Basic\PDFLibBasic.dproj"/>
    </Target>
    <Target Name="PDFLibBasic:Clean">
        <MSBuild Projects="Samples\VCL\PDFLib-Basic\PDFLibBasic.dproj" Targets="Clean"/>
